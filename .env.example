# prod | dev | test. В prod приложение не стартует с учебным JWT_SECRET и паролями admin12345 / products.
APP_ENV=dev
# 1 показывает подробности ошибок API
APP_DEBUG=0

# nginx публикует приложение только на 127.0.0.1. Адрес: http://localhost:8080
APP_PORT=8080

# PostgreSQL. В контейнерах хост — db, с хоста для тестов — 127.0.0.1:54329
DATABASE_URL=postgresql://products:products@db:5432/products
DB_NAME=products
DB_USER=products
DB_PASSWORD=products
DB_PORT=54329

# Секрет подписи JWT, минимум 32 символа. В проде замените.
JWT_SECRET=change-me-change-me-change-me-32
JWT_TTL=28800

# Каталог файлов импорта и скачанных изображений внутри контейнера
STORAGE_PATH=/var/www/storage

# Ограничение xlsx: 10 МБ. Не больше 5 импортов за 60 секунд на пользователя
IMPORT_MAX_BYTES=10485760
IMPORT_RATE_LIMIT=5
IMPORT_RATE_WINDOW=60
LOGIN_RATE_LIMIT=10

# Скачивание картинок: размер и таймаут одного запроса
IMAGE_MAX_BYTES=5242880
IMAGE_TIMEOUT=12

# amqp://user:password@host:port/vhost. %2f — это vhost /
RABBITMQ_DSN=amqp://products:products@rabbitmq:5672/%2f
RABBITMQ_USER=products
RABBITMQ_PASSWORD=products
# amqp — боевая очередь, in-memory — только для автотестов
MESSENGER_TRANSPORT=amqp

# Учётка создаётся командой admin:ensure, если пользователя ещё нет
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin12345
ADMIN_NAME=Administrator

# Origin фронтенда для CORS в режиме ng serve
CORS_ORIGIN=http://localhost:4200

# 1 — сервис app применяет миграции и создаёт администратора при старте
RUN_MIGRATIONS=1
